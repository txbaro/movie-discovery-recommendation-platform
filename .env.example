# Đổi tên file này thành .env và điền giá trị thật

# Biến dùng bởi docker-compose.yml để khởi tạo container PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=movie_booking

# LƯU Ý: không cần sửa DATABASE_URL bên dưới khi chạy bằng Docker —
# docker-compose.yml tự động GHI ĐÈ biến này bằng hostname "db" (tên service),
# không phải "localhost", vì bên trong mạng Docker các container gọi nhau
# qua tên service. Giá trị dưới đây chỉ là fallback/tài liệu tham khảo,
# không thực sự được dùng khi chạy `docker compose up`.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/movie_booking

# Secret key dùng cho JWT — tạo bằng: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
APP_BASE_URL=http://localhost:8001
COOKIE_SECURE=false
SQL_ECHO=false
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# (Tuỳ chọn) Gemini embedding cho gợi ý phim bằng ngôn ngữ tự nhiên.
# Tạo key tại Google AI Studio. Nếu bỏ trống, service fallback sang TF-IDF.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# API key TMDB (The Movie Database) — dùng để import dữ liệu phim thật.
TMDB_API_KEY=

REDIS_URL=redis://localhost:6379/0

# Redis trong production: quota AI, cache prompt embedding, collector lock,
# reset-password token. Bật booking demo mới khởi động seat-expiry listener.
AI_REQUESTS_PER_USER_PER_DAY=20
AI_REQUESTS_PER_IP_PER_DAY=100
AI_PROMPT_CACHE_TTL_SECONDS=86400
COLLECTOR_LOCK_TTL_SECONDS=3600
COLLECTOR_FRESHNESS_HOURS=8
# Scheduler container: run every 6 hours, stagger providers by 10 minutes.
COLLECTOR_SCHEDULER_SOURCES=cinestar,lotte,galaxy
COLLECTOR_SCHEDULE_INTERVAL_MINUTES=360
COLLECTOR_STAGGER_MINUTES=10
COLLECTOR_SYNC_DAYS=7
ENABLE_INTERNAL_BOOKING=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=True
